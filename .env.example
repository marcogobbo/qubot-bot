# =============================================================================
# QuBot configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------
DISCORD_TOKEN=your-discord-bot-token

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Daily scheduled report
# -----------------------------------------------------------------------------
DAILY_REPORT_HOUR=9
DAILY_REPORT_MINUTE=30
# Timezone for the daily scheduler (IANA name, e.g. Europe/Rome, UTC).
DAILY_REPORT_TZ=Europe/Rome

# -----------------------------------------------------------------------------
# Monday Meeting reminder
# -----------------------------------------------------------------------------
MONDAY_MEETING_ZOOM_URL=https://zoom.us/j/your-meeting-id
MONDAY_MEETING_MINUTES_URL=https://docs.example.com/meeting-minutes
MONDAY_MEETING_DESTINATION_ID=000000000000000000
MONDAY_MEETING_DESTINATION_TYPE=channel
MONDAY_MEETING_HOUR=9
MONDAY_MEETING_MINUTE=15

# -----------------------------------------------------------------------------
# WAMP (Proteox / OI DECS) — global credentials
# -----------------------------------------------------------------------------
# qtics reads these directly from the process environment at import time.
# All three fridges share these credentials (one bot process = one WAMP user).
# WAMP_ROUTER_URL and WAMP_REALM here act as defaults; per-fridge
# <FRIDGE>_PROTEOX_URL and <FRIDGE>_PROTEOX_REALM override them per connection.
WAMP_USER=
WAMP_USER_SECRET=
WAMP_REALM=ucss
WAMP_ROUTER_URL=ws://decs-router.lab.local:8080/ws
# Note: BIND_SERVER_TO_INTERFACE and SERVER_PORT belong to the DECS server
# configuration on the cryostat host — they are NOT consumed by QuBot.

# -----------------------------------------------------------------------------
# UTA (HVAC) CGI source
# -----------------------------------------------------------------------------
# /uta fetches the legacy utareport_html CGI and parses its HTML. The CGI
# already lives inside the lab and has direct access to the UTA controller,
# so this avoids the FTP-firewall problem QuBot would hit going direct.
# Use http:// — the server's TLS is too old for modern clients.
UTA_CGI_URL=http://artico.mib.infn.it/cgi-bin/utareport_html
UTA_CGI_TIMEOUT=10.0

# -----------------------------------------------------------------------------
# Per-fridge configuration
# -----------------------------------------------------------------------------
# DESTINATION_TYPE must be either `thread` or `channel`.
# Each fridge can post to a different server/guild — the destination ID alone
# is enough; discord.py resolves it across all guilds the bot is in.

# --- Elsa ---
ELSA_PROTEOX_URL=ws://elsa.lab.local:8080/ws
ELSA_PROTEOX_REALM=ucss
ELSA_DESTINATION_ID=000000000000000000
ELSA_DESTINATION_TYPE=thread

# --- Anna ---
ANNA_PROTEOX_URL=ws://anna.lab.local:8080/ws
ANNA_PROTEOX_REALM=ucss
ANNA_DESTINATION_ID=000000000000000000
ANNA_DESTINATION_TYPE=channel

# --- Olaf ---
OLAF_PROTEOX_URL=ws://olaf.lab.local:8080/ws
OLAF_PROTEOX_REALM=ucss
OLAF_DESTINATION_ID=000000000000000000
OLAF_DESTINATION_TYPE=thread
